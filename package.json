{
  "name": "into-the-politicalverse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run safety:check && npm run data:build:candidates",
    "dev": "next dev --hostname 127.0.0.1 --port 4317",
    "build": "next build",
    "build:pages": "next build",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm run typecheck:insights && npm test && npm run test:insights && npm run build",
    "data:import": "node --import tsx scripts/import-valmyndigheten.ts",
    "data:import:municipality-history": "node --import tsx scripts/import-valmyndigheten-municipality-history.ts",
    "data:import:geography": "node --import tsx scripts/import-valmyndigheten-geography.ts",
    "data:import:seats": "node --import tsx scripts/import-valmyndigheten-seats.ts",
    "data:forecast:generate": "node --import tsx scripts/generate-election-forecast.ts",
    "data:polls:update": "node --import tsx scripts/update-opinion-polls.ts",
    "data:live:update": "node --import tsx scripts/update-election-live.ts",
    "data:live:rehearse": "node --import tsx scripts/update-election-live.ts --rehearsal",
    "data:import:preparation": "node --import tsx scripts/import-election-preparation.ts",
    "data:verify": "node --import tsx scripts/verify-election-data.ts",
    "safety:check": "node scripts/safety-preflight.mjs",
    "data:import:local": "node --import tsx scripts/import-local-geography.ts",
    "data:import:localities": "node --import tsx scripts/import-scb-localities.ts",
    "data:import:personal": "node --import tsx scripts/import-personal-votes.ts",
    "data:import:candidates": "python3 scripts/import-candidate-history.py",
    "data:build:candidates": "node --import tsx scripts/build-candidate-data.ts",
    "prebuild": "npm run data:build:candidates",
    "prebuild:pages": "npm run data:build:candidates",
    "data:forecast:reference": "node --import tsx scripts/preserve-forecast-reference.ts",
    "data:2026:stage": "node --import tsx scripts/stage-election-2026.ts",
    "test:insights": "node --test workers/insights/tests/*.test.mjs",
    "typecheck:insights": "tsc --noEmit -p workers/insights/tsconfig.json"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "web-vitals": "^6.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "jszip": "^3.10.1",
    "miniflare": "^5.20260907.0-alpha",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.129.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
