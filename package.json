{
  "name": "into-the-politicalverse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run safety:check",
    "dev": "next dev --hostname 127.0.0.1 --port 4317",
    "build": "next build",
    "build:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "data:import": "node --import tsx scripts/import-valmyndigheten.ts",
    "data:import:geography": "node --import tsx scripts/import-valmyndigheten-geography.ts",
    "data:import:seats": "node --import tsx scripts/import-valmyndigheten-seats.ts",
    "data:verify": "node --import tsx scripts/verify-election-data.ts",
    "safety:check": "node scripts/safety-preflight.mjs"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@openai/sites-vite-plugin": "^0.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitejs/plugin-rsc": "^0.5.26",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "exceljs": "^4.4.0",
    "mapshaper": "0.6.113",
    "react-server-dom-webpack": "^19.2.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vinext": "^1.0.0-beta.2",
    "vite": "^8.0.13",
    "wrangler": "^4.92.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
