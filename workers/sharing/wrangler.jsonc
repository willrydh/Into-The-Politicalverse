{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "politicalverse-sharing",
  "main": "src/index.ts",
  "account_id": "5812c395d29b11471568de01b4674bc7",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "SITE_ORIGIN": "https://politicalverse.se" },
  "routes": [
    { "pattern": "politicalverse.se/people*", "zone_name": "politicalverse.se" },
    { "pattern": "politicalverse.se/en/people*", "zone_name": "politicalverse.se" },
    { "pattern": "politicalverse.se/share/candidate/*", "zone_name": "politicalverse.se" }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "rules": [
    { "type": "Data", "globs": ["**/*.woff"], "fallthrough": true },
    { "type": "Text", "globs": ["**/*.svg"], "fallthrough": true }
  ]
}
